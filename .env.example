
# —— 对话模型（DeepSeek，OpenAI 兼容接口）——
OPENAI_API_KEY=sk-请填写你的DeepSeekKey
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# —— 向量 / 重排（SiliconFlow：bge-m3 向量 + bge-reranker-v2-m3 重排）——
SILICONFLOW_API_KEY=sk-请填写你的SiliconFlowKey

# —— 可选：覆盖嵌入/重排服务（默认取 config/config.yaml 的 embedding 配置）——
# OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
